<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".EDMApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EDM"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.EDM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a link from any browser to EDM. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Download hand-off from browsers: any file type over http(s).
                 Keep these filters MIME-typed: Firefox classifies any activity that
                 resolves an untyped http(s) VIEW intent as a browser and removes it
                 from its downloader chooser (see LinkActivity). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- The */* filter above covers every MIME type, so no per-type list is needed. -->
            <!-- Untyped links that point at a file. Matching on the extension (instead of
                 handling every http link) keeps this activity out of Firefox's browser set;
                 path patterns only work when the filter also declares a host, and they use
                 simple-glob syntax (no [aA] classes), so each extension is listed twice. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.M4V" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.FLV" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.WMV" />
                <data android:pathPattern=".*\\.mpg" />
                <data android:pathPattern=".*\\.MPG" />
                <data android:pathPattern=".*\\.mpeg" />
                <data android:pathPattern=".*\\.MPEG" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.3GP" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.TS" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.MP3" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.M4A" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.OPUS" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.WAV" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.FLAC" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.OGG" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.AAC" />
                <data android:pathPattern=".*\\.mid" />
                <data android:pathPattern=".*\\.MID" />
                <data android:pathPattern=".*\\.jpg" />
                <data android:pathPattern=".*\\.JPG" />
                <data android:pathPattern=".*\\.jpeg" />
                <data android:pathPattern=".*\\.JPEG" />
                <data android:pathPattern=".*\\.png" />
                <data android:pathPattern=".*\\.PNG" />
                <data android:pathPattern=".*\\.gif" />
                <data android:pathPattern=".*\\.GIF" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\.WEBP" />
                <data android:pathPattern=".*\\.svg" />
                <data android:pathPattern=".*\\.SVG" />
                <data android:pathPattern=".*\\.bmp" />
                <data android:pathPattern=".*\\.BMP" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\.HEIC" />
                <data android:pathPattern=".*\\.tiff" />
                <data android:pathPattern=".*\\.TIFF" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.APK" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\.XAPK" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.RAR" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.7Z" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.TAR" />
                <data android:pathPattern=".*\\.gz" />
                <data android:pathPattern=".*\\.GZ" />
                <data android:pathPattern=".*\\.iso" />
                <data android:pathPattern=".*\\.ISO" />
                <data android:pathPattern=".*\\.bin" />
                <data android:pathPattern=".*\\.BIN" />
                <data android:pathPattern=".*\\.torrent" />
                <data android:pathPattern=".*\\.TORRENT" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\.DOC" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.DOCX" />
                <data android:pathPattern=".*\\.xls" />
                <data android:pathPattern=".*\\.XLS" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\.XLSX" />
                <data android:pathPattern=".*\\.ppt" />
                <data android:pathPattern=".*\\.PPT" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\.PPTX" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.CSV" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.JSON" />
            </intent-filter>
        </activity>

        <!-- Untyped http(s) link handler. Must stay on its own activity: see LinkActivity. -->
        <activity
            android:name=".LinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Media hand-offs from browsers arrive as blob:/data: URIs; explain them politely. -->
        <activity
            android:name=".HandoffActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.EDM">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="blob" />
                <data android:scheme="data" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Media viewer "save to device": browsers pass just a MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
