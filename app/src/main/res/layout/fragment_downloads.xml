<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/downloadTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/edm_surface"
        android:elevation="1dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/edm_primary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/edm_primary_container"
        app:tabSelectedTextColor="@color/edm_primary"
        app:tabTextColor="@color/edm_text_secondary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/downloadPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
